# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=familypay
POSTGRES_USER=familypay
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://familypay:changeme@postgres:5432/familypay

# Backend
JWT_SECRET=change-this-to-a-long-random-string
MISTRAL_API_KEY=
BACKEND_PORT=3000

# Web (Next.js)
# NEXT_PUBLIC_GRAPHQL_URL : URL GraphQL vue depuis le NAVIGATEUR (baked au
# build Next.js). En dev local → http://localhost:3000/graphql (le port du
# backend exposé sur l'hôte). Le browser passe par le proxy /api/graphql, mais
# cette variable sert de fallback server-side si GRAPHQL_URL n'est pas défini.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3000/graphql
WEB_PORT=3001

# Mobile (build config, pas dans docker-compose)
# GRAPHQL_URL : URL GraphQL vue depuis l'app mobile (device/emulateur), qui
# atteint le backend via le port exposé sur l'hôte. Le container nextjs, lui,
# utilise http://backend:3000/graphql (interne compose, défini directement
# dans docker-compose.yml — pas ici).
GRAPHQL_URL=http://localhost:3000/graphql
