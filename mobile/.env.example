# URL du backend GraphQL (dev local).
# Le backend n'est plus exposé directement : tout passe par Nginx sur le port 80.
# En dev sur émulateur Android, remplacer localhost par 10.0.2.2 (alias de l'hôte).
# Sur simulateur iOS, localhost fonctionne car il partage le réseau de l'hôte.
GRAPHQL_URL=http://localhost/graphql

# EC2 instance case
# GRAPHQL_URL=http://35.180.181.128/graphql